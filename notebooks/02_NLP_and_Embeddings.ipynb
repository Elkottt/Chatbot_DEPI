import pandas as pd
import sys
import os
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import linear_kernel

class UniversityChatbot:
    def __init__(self, filepath):
        if not os.path.exists(filepath):
            print(f"CRITICAL ERROR: The file '{filepath}' was not found.")
            print("Make sure the CSV file is in the same folder as this script.")
            sys.exit(1)

        print("System Status: Loading database and training NLP model...")
        
        try:
            self.df = pd.read_csv(filepath)
            
            self.df['text_content'] = (
                self.df['program'].fillna('') + " " + 
                self.df['university_name'].fillna('') + " " + 
                self.df['course_languageEn'].fillna('')
            )
            
            self.tfidf = TfidfVectorizer(stop_words='english')
            self.tfidf_matrix = self.tfidf.fit_transform(self.df['text_content'])
            
            self.last_results = None 
            
            print(f"System Ready! Loaded {len(self.df)} programs.")
            print("(Press Ctrl+C to stop at any time)\n")
            
        except Exception as e:
            print(f"ERROR: Failed to process the data file.")
            print(f"Details: {e}")
            sys.exit(1)
    
    def get_intent(self, user_input):
        user_input = user_input.lower().strip()
        
        if user_input in ['hi', 'hello', 'hey', 'start', 'greetings']:
            return 'greeting'
        
        elif user_input in ['bye', 'exit', 'quit', 'stop']:
            return 'goodbye'
        
        elif any(word in user_input for word in ['cheap', 'lowest', 'cost', 'fee', 'price']) and self.last_results is not None:
            return 'refine_price'
        
        else:
            return 'search'

    def search_programs(self, query):
        query_vec = self.tfidf.transform([query])
        
        cosine_similarities = linear_kernel(query_vec, self.tfidf_matrix).flatten()
        
        related_docs_indices = cosine_similarities.argsort()[:-6:-1]
        
        results = self.df.iloc[related_docs_indices][['program', 'university_name', 'fees']]
        
        self.last_results = results 
        return results

    def start_chat(self):
        print("BOT: Hello! I am your University Assistant. What are you looking for?")
        
        while True:
            try:
                user_input = input("YOU: ")
                
                if not user_input.strip():
                    continue

                intent = self.get_intent(user_input)
                
                if intent == 'greeting':
                    print("BOT: Hi there! Try searching for things like 'MSc in Canada' or 'Civil Engineering'.")
                
                elif intent == 'goodbye':
                    print("BOT: Good luck with your studies! Goodbye.")
                    break
                    
                elif intent == 'refine_price':
                    print("BOT: I've sorted your previous results by Lowest Fees:")
                    if self.last_results is not None:
                        sorted_results = self.last_results.sort_values('fees', ascending=True)
                        print(sorted_results.to_string(index=False))
                    else:
                        print("BOT: Please search for a program first.")
                    
                elif intent == 'search':
                    print(f"BOT: Searching database for '{user_input}'...")
                    results = self.search_programs(user_input)
                    
                    if results.empty:
                        print("BOT: I couldn't find any matching programs. Try different keywords.")
                    else:
                        print(results.to_string(index=False))
                
                print("-" * 60)
                
            except KeyboardInterrupt:
                print("\nBOT: Exiting...")
                break
            except Exception as e:
                print(f"BOT: Oops, something went wrong: {e}")

if __name__ == "__main__":
    csv_filename = 'all_programs_cleaned.xlsx - Sheet1.csv'
    
    bot = UniversityChatbot(csv_filename)
    bot.start_chat()
